#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
set -eu
PATH=/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
ENABLED=0
INFORM_URL=''
SSH_LISTEN=':2222'
MODEL='U7PG2'
APPLY=0
WLAN_TEST_ONLY=0
WLAN_ONLY=0
LED_CONTROL=0
CLIENT_BLOCK_CONTROL=0
REBOOT_CONTROL=0
EXPERIMENTAL_SAE=0
REPORT_UPGRADE_VERSION=0
SLOTS=''
NETWORKS=''
EXPERIMENTAL_FT_DOMAINS=''
STATE_DIR='/opt/var/lib/unifi-keenetic'
PID_FILE='/opt/var/run/unifi-keenetic.pid'
config=${UKN_CONFIG:-/opt/etc/unifi-keenetic.conf}
[ ! -r "$config" ] || . "$config"
daemon=/opt/sbin/ukn
pid=$PID_FILE
for path in "$STATE_DIR" "$PID_FILE"; do
 case "$path" in /*) ;; *) printf '%s\n' 'STATE_DIR and PID_FILE must be absolute paths' >&2; exit 1 ;; esac
done
case "$STATE_DIR" in *'
'*) printf '%s\n' 'STATE_DIR must not contain a newline' >&2; exit 1 ;; esac
process_matches() {
 observed_pid=$1
 case "$observed_pid" in ''|*[!0-9]*|0|1) return 1 ;; esac
 expected_exe=$(readlink -f "$daemon" 2>/dev/null || true)
 [ -n "$expected_exe" ] && kill -0 "$observed_pid" 2>/dev/null &&
  [ -r "/proc/$observed_pid/status" ] &&
  ! grep -q '^State:[[:space:]]*Z' "/proc/$observed_pid/status" 2>/dev/null &&
  [ "$(readlink "/proc/$observed_pid/exe" 2>/dev/null)" = "$expected_exe" ] || return 1
 [ -r "/proc/$observed_pid/cmdline" ] || return 1
 # The service always supplies -state first. Preserve spaces/backslashes and
 # reject later overrides and diagnostic/recovery modes. This is a service
 # argument-shape check, not authentication or atomic PID-generation signalling.
 tr '\000' '\n' < "/proc/$observed_pid/cmdline" | {
  valid=1
  IFS= read -r executable && IFS= read -r option && IFS= read -r selected_state &&
   [ "$option" = -state ] && [ "$selected_state" = "$STATE_DIR" ] || valid=0
  while IFS= read -r argument; do
   case "$argument" in -*)
    argument=${argument%%=*}
    argument=${argument#-}
    argument=${argument#-}
    case "$argument" in
     state|probe|terminal-probe|wifi-system-status|installation-status|rollback-probe|rollback-probe-mode|crash-probe|rollback-watch|rollback-id|plan|plan-json|preflight-running|provision-status|build-info|models) valid=0 ;;
    esac ;;
   esac
  done
  [ "$valid" = 1 ]
 }
}
daemon_running() {
 [ -r "$pid" ] || return 1
 current_pid=$(cat "$pid")
 process_matches "$current_pid"
}
case "${1:-}" in
 start)
  [ "$ENABLED" = 1 ] || { printf '%s\n' 'unifi-keenetic is disabled'; exit 0; }
  # An interrupted upgrade must not boot a mixture of old and new files.
  # Only the installer's completed rollback can bypass its own transaction.
  recovery=${UKN_INSTALL_RECOVERY:-}
  for pending in /opt/.ukn-install.*; do
   [ -e "$pending" ] || [ -L "$pending" ] || continue
   allowed=0
   if [ -n "$recovery" ] && [ -d "$recovery" ] && [ "$(cat "$recovery/phase" 2>/dev/null || true)" = restored ]; then
    if [ "$pending" = "$recovery" ]; then allowed=1; fi
    if [ "$pending" = /opt/.ukn-install.lock ] && [ "$(cat "$pending/work-directory" 2>/dev/null || true)" = "$recovery" ]; then allowed=1; fi
   fi
   [ "$allowed" = 1 ] || { printf '%s\n' 'Unfinished installation data exists; inspect it before starting the agent' >&2; exit 1; }
  done
  unset UKN_INSTALL_RECOVERY
  [ -n "$INFORM_URL" ] || { printf '%s\n' 'INFORM_URL is required' >&2; exit 1; }
  for option in "$APPLY" "$WLAN_TEST_ONLY" "$WLAN_ONLY" "$LED_CONTROL" "$CLIENT_BLOCK_CONTROL" "$REBOOT_CONTROL" "$REPORT_UPGRADE_VERSION" "$EXPERIMENTAL_SAE"; do
   case "$option" in 0|1) ;; *) printf '%s\n' 'Action switches must be 0 or 1' >&2; exit 1 ;; esac
  done
  if [ "$APPLY" = 1 ] || [ "$WLAN_TEST_ONLY" = 1 ] || [ "$WLAN_ONLY" = 1 ] || [ "$CLIENT_BLOCK_CONTROL" = 1 ]; then
   [ -n "$SLOTS" ] || { printf '%s\n' 'SLOTS is required for application, client blocking, WLAN test mode or WLAN-only mode' >&2; exit 1; }
  fi
  if [ "$WLAN_TEST_ONLY" = 1 ] && [ -n "$NETWORKS" ]; then
   printf '%s\n' 'NETWORKS cannot be used in connected Wi-Fi test mode' >&2
   exit 1
  fi
  if [ "$WLAN_TEST_ONLY" = 1 ] && [ "$WLAN_ONLY" = 1 ]; then
   printf '%s\n' 'WLAN_TEST_ONLY and WLAN_ONLY are mutually exclusive' >&2
   exit 1
  fi
  if [ "$WLAN_TEST_ONLY" = 1 ] && [ "$REBOOT_CONTROL" = 1 ]; then
   printf '%s\n' 'REBOOT_CONTROL cannot be used in WLAN test mode' >&2
   exit 1
  fi
  set -- -state "$STATE_DIR" -url "$INFORM_URL" -ssh-listen "$SSH_LISTEN" -model "$MODEL"
  if [ -n "$SLOTS" ]; then
   [ -r "$SLOTS" ] || { printf '%s\n' 'SLOTS file is not readable' >&2; exit 1; }
   set -- "$@" -slots "$SLOTS"
  fi
  if [ -n "$NETWORKS" ]; then
   [ -r "$NETWORKS" ] || { printf '%s\n' 'NETWORKS file is not readable' >&2; exit 1; }
   set -- "$@" -networks "$NETWORKS"
  fi
  if [ -n "$EXPERIMENTAL_FT_DOMAINS" ]; then
   [ -r "$EXPERIMENTAL_FT_DOMAINS" ] || { printf '%s\n' 'EXPERIMENTAL_FT_DOMAINS file is not readable' >&2; exit 1; }
   set -- "$@" -experimental-ft-domains "$EXPERIMENTAL_FT_DOMAINS"
  fi
  [ "$APPLY" = 0 ] || set -- "$@" -apply
  [ "$WLAN_TEST_ONLY" = 0 ] || set -- "$@" -wlan-test-only
  [ "$WLAN_ONLY" = 0 ] || set -- "$@" -wlan-only
  [ "$EXPERIMENTAL_SAE" = 0 ] || set -- "$@" -experimental-sae
  [ "$LED_CONTROL" = 0 ] || set -- "$@" -led-control
  [ "$REBOOT_CONTROL" = 0 ] || set -- "$@" -reboot-control
  [ "$REPORT_UPGRADE_VERSION" = 0 ] || set -- "$@" -report-upgrade-version
  [ "$CLIENT_BLOCK_CONTROL" = 0 ] || set -- "$@" -client-block-control
  if daemon_running; then
   printf 'unifi-keenetic is already running (PID %s)\n' "$current_pid"
   exit 0
  fi
  mkdir -p "$(dirname "$pid")" "$STATE_DIR"
  chmod 700 "$STATE_DIR"
  start-stop-daemon -S -b -m -p "$pid" -x "$daemon" -- "$@"
  attempts=0
  until daemon_running; do
   [ "$attempts" -lt 5 ] || { printf '%s\n' 'Daemon process was not established; inspect configuration and state' >&2; exit 1; }
   sleep 1
   attempts=$((attempts + 1))
  done
  # Process existence is not controller/WLAN health. Catch immediate exits
  # (for example invalid saved state), without claiming complete readiness.
  sleep 1
  daemon_running || { printf '%s\n' 'Daemon exited during startup; inspect configuration and state' >&2; exit 1; }
  ;;
 stop)
  old_pid=''
  if [ -r "$pid" ]; then
   old_pid=$(cat "$pid")
   case "$old_pid" in ''|*[!0-9]*|0|1) printf '%s\n' 'Invalid daemon PID file; refusing stop' >&2; exit 1 ;; esac
  fi
  [ -n "$old_pid" ] || exit 0
  if ! kill -0 "$old_pid" 2>/dev/null; then exit 0; fi
  if [ -r "/proc/$old_pid/status" ] && grep -q '^State:[[:space:]]*Z' "/proc/$old_pid/status" 2>/dev/null; then exit 0; fi
  process_matches "$old_pid" || { printf '%s\n' 'PID does not identify the selected instance; refusing stop' >&2; exit 1; }
  # Signal the checked PID, not a PID file that can change after validation.
  kill -TERM "$old_pid"
  attempts=0
  while process_matches "$old_pid"; do
   # A zombie has exited and released its locks; its parent may reap it later.
   if [ -r "/proc/$old_pid/status" ] && grep -q '^State:[[:space:]]*Z' "/proc/$old_pid/status" 2>/dev/null; then break; fi
   [ "$attempts" -lt 15 ] || { printf '%s\n' 'Daemon has not exited; refusing immediate restart' >&2; exit 1; }
   sleep 1
   attempts=$((attempts + 1))
  done
  ;;
 status)
  if [ ! -r "$pid" ]; then printf '%s\n' 'unifi-keenetic is not running'; exit 3; fi
  current_pid=$(cat "$pid")
  case "$current_pid" in ''|*[!0-9]*|0|1) printf '%s\n' 'Invalid daemon PID file'; exit 3 ;; esac
  if daemon_running; then
   printf 'unifi-keenetic is running (PID %s)\n' "$current_pid"
   exit 0
  fi
  printf '%s\n' 'unifi-keenetic is not running (stale or unrelated PID)'
  exit 3
  ;;
 restart)
  "$0" stop
  "$0" start
  ;;
 *) printf 'Usage: %s {start|stop|restart|status}\n' "$0" >&2; exit 1 ;;
esac
